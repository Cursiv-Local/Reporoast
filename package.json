{
  "name": "reporoast",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "deploy:staging": "npm run verify && wrangler deploy --env staging",
    "deploy:production": "npm run verify && node scripts/deploy-production.mjs",
    "test:integration": "wrangler deploy --dry-run --outdir .wrangler/dry-run --env staging && node tests/worker.integration.mjs",
    "verify": "npm run check && npm run test:integration && npm run test:e2e",
    "smoke:live": "wrangler deploy --dry-run --outdir .wrangler/dry-run --env staging && node scripts/live-smoke.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "test:scoring": "vitest run tests/scoring-v2.test.ts tests/cross-repository.test.ts",
    "test:premium": "vitest run tests/premium.test.ts",
    "validate:scoring": "node scripts/document-scoring.mjs && node scripts/validate-scoring.mjs",
    "generate:example": "node scripts/generate-example.mjs",
    "smoke:production": "node scripts/smoke-staging.mjs production"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "miniflare": "^5.20261023.1-beta",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}