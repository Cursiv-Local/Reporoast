{
  "name": "reporoast-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/s/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Coordinator"
      ]
    }
  ],
  "vars": {
    "SCANS_ENABLED": "false",
    "DAILY_LIMIT": "100",
    "IP_LIMIT": "5",
    "MAX_CONCURRENT": "2",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787"
  },
  "env": {
    "staging": {
      "name": "reporoast-staging",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          {
            "name": "COORDINATOR",
            "class_name": "Coordinator"
          }
        ]
      },
      "vars": {
        "SCANS_ENABLED": "true",
        "DAILY_LIMIT": "30",
        "IP_LIMIT": "10",
        "MAX_CONCURRENT": "2",
        "PUBLIC_ORIGIN": "https://reporoast-staging.joshua-1993-winkler.workers.dev"
      }
    },
    "production": {
      "name": "reporoast-production",
      "workers_dev": false,
      "durable_objects": {
        "bindings": [
          {
            "name": "COORDINATOR",
            "class_name": "Coordinator"
          }
        ]
      },
      "vars": {
        "SCANS_ENABLED": "true",
        "DAILY_LIMIT": "100",
        "IP_LIMIT": "5",
        "MAX_CONCURRENT": "2",
        "PUBLIC_ORIGIN": "https://roast.cursiv.us",
        "CANONICAL_REDIRECTS": "true"
      },
      "preview_urls": false,
      "routes": [
        {
          "zone_id": "08a275b81c4a8ba471461d3a0b50d96b",
          "custom_domain": true,
          "pattern": "roast.cursiv.us"
        }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      }
    }
  },
  "observability": {
    "enabled": false
  },
  "account_id": "4d696ef5a03fc9671ee6e99df25a9ba1"
}